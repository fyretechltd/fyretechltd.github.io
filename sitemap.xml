---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for page in site.pages %}
  {%- if page.url contains ".xml" or page.url contains ".txt" or page.url contains ".css" or page.url == "/404.html" %}{% continue %}{% endif %}
  <url><loc>{{ page.url | absolute_url }}</loc></url>
{%- endfor %}
{%- for file in site.static_files %}
  {%- if file.extname == ".html" %}
  <url><loc>{{ file.path | replace: "/index.html", "/" | absolute_url }}</loc></url>
  {%- endif %}
{%- endfor %}
</urlset>
